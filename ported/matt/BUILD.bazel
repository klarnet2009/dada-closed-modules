load("/<build-dir>", "ddk_module")

ddk_module(
    name = "matt",
    srcs = glob(["*.c", "*.h"]),
    out = "matt.ko",
    defconfig = "matt_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    copts = ["-ffunction-sections", "-fdata-sections", "-Wno-unused-function", "-Wno-unused-variable"],  # PARTIAL: helpers not referenced yet
    local_defines = ["CONFIG_LTO=1"],
    visibility = ["//re:__subpackages__"],
    kernel_build = "//common:kernel_aarch64",
    includes = ["."],
    deps = ["//common:all_headers_aarch64"],
)
