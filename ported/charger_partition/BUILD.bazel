load("/<build-dir>", "ddk_module")

ddk_module(
    name = "charger_partition",
    srcs = ["charger_partition.c"] + glob(["inc/*.h"]),
    out = "charger_partition.ko",
    includes = ["inc"],
    defconfig = "charger_partition_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    local_defines = ["CONFIG_LTO=1"],
    copts = ["-ffunction-sections", "-fdata-sections"],
    kernel_build = "//common:kernel_aarch64",
    deps = [
        "//re/stubs_portB:mca_headers",
        "//re/stubs_portB:stub_all",
        "//common:all_headers_aarch64",
    ],
)
