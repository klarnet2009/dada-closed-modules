load("/<build-dir>", "ddk_module")

ddk_module(
    name = "xiaomi_wifi_gpio",
    srcs = ["xiaomi_wifi_gpio.c", "hwid.h"],
    out = "xiaomi_wifi_gpio.ko",
    defconfig = "xiaomi_wifi_gpio_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    local_defines = ["CONFIG_LTO=1"],
    copts = ["-ffunction-sections", "-fdata-sections"],
    kernel_build = "//common:kernel_aarch64",
    deps = [
        "//re/hwid:hwid",
        "//common:all_headers_aarch64",
    ],
)
