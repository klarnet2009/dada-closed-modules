load("/<build-dir>", "ddk_module")

ddk_module(
    name = "sc8581",
    srcs = ["sc8581.c"] + glob(["inc/*.h"]),
    out = "sc8581.ko",
    defconfig = "sc8581_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    local_defines = ["CONFIG_LTO=1", "CONFIG_DEBUG_FS=1"],
    copts = ["-ffunction-sections", "-fdata-sections"],
    kernel_build = "//common:kernel_aarch64",
    deps = [
        "//re/stubs_portB:mca_headers",
        "//re/stubs_portB:stub_all",
        "//common:all_headers_aarch64",
    ],
)
