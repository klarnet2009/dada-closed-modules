    local_defines = ["CONFIG_LTO=1"],
    visibility = ["//re:__subpackages__"],
    kernel_build = "//common:kernel_aarch64",
    deps = ["//re/stubs_g1/os4:os4_xr_qi", "//re/stubs_g1/os4:os4_miev", "//re/stubs_g1/os4:os4_qcom_dma_heaps", "//common:all_headers_aarch64"],
)
