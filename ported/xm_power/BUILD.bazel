load("/<build-dir>", "ddk_module")

ddk_module(
    name = "xm_power",
    srcs = ["xm_power.c", "xm_power.h"],
    out = "xm_power.ko",
    defconfig = "xm_power_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    local_defines = ["CONFIG_LTO=1"],
    copts = ["-ffunction-sections", "-fdata-sections"],
    kernel_build = "//common:kernel_aarch64",
    deps = ["//common:all_headers_aarch64"],
)
