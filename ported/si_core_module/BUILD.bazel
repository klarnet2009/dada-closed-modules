load("/<build-dir>", "ddk_module")

ddk_module(
    name = "si_core_module",
    srcs = glob(["*.c", "*.h"]),
    out = "si_core_module.ko",
    defconfig = "si_core_module_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    copts = ["-ffunction-sections", "-fdata-sections"],
    local_defines = ["CONFIG_LTO=1", "CONFIG_QCOM_SI_CORE_WQ=1", "CONFIG_QCOM_SI_CORE=1", "CONFIG_QSEECOM_PROXY=1"],
    visibility = ["//re:__subpackages__"],
    kernel_build = "//common:kernel_aarch64",
    deps = ["//re/stubs_portA:portA_headers", "//re/stubs_portA:si_core_stub", "//common:all_headers_aarch64"],
)
