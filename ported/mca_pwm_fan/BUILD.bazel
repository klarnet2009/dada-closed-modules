load("/<build-dir>", "ddk_module")

package(default_visibility = ["//re:__subpackages__"])

ddk_module(
    name = "mca_pwm_fan",
    srcs = glob(["*.c", "*.h"]),
    out = "mca_pwm_fan.ko",
    defconfig = "mca_pwm_fan_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    local_defines = ["CONFIG_DEBUG_FS=1"],
    copts = ["-ffunction-sections", "-fdata-sections"],
    kernel_build = "//common:kernel_aarch64",
    deps = [
        "//re/stubs_a17B:mca_headers",
        "//re/stubs_a17B/os4:os4_mca_log",
        "//re/stubs_a17B/os4:os4_mca_event",
        "//re/stubs_a17B/os4:os4_mca_hwid",
        "//re/stubs_a17B/os4:os4_mca_parse_dts",
        "//re/stubs_a17B/os4:os4_mca_sysfs",
        "//common:all_headers_aarch64",
    ],
)
