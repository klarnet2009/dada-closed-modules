load("/<build-dir>", "ddk_module")

ddk_module(
    name = "stm_st54se_gpio",
    srcs = ["stm_st54se_gpio.c"],
    out = "stm_st54se_gpio.ko",
    defconfig = "stm_st54se_gpio_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    local_defines = ["CONFIG_LTO=1"],
    copts = ["-ffunction-sections", "-fdata-sections"],
    kernel_build = "//common:kernel_aarch64",
    deps = [
        "//re/stubs_a17C:stub_hwid",
        "//common:all_headers_aarch64",
    ],
)
