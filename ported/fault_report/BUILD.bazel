load("/<build-dir>", "ddk_module")

ddk_module(
    name = "fault_report",
    srcs = glob(["*.c", "*.h"]),
    out = "fault_report.ko",
    defconfig = "fault_report_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    copts = ["-ffunction-sections", "-fdata-sections"],
    local_defines = ["CONFIG_LTO=1", "CONFIG_MIEV=1"],
    visibility = ["//re:__subpackages__"],
    kernel_build = "//common:kernel_aarch64",
    deps = ["//re/stubs_g1/os4:os4_miev", "//common:all_headers_aarch64"],
)
