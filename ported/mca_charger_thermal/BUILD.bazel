load("/<build-dir>", "ddk_module")

# ThinLTO build like the stock (CONFIG_LTO_CLANG_THIN via defconfig).  SAFETY: charging module, source for the community only - never flash it,
# never put it into a ROM build (the ROM uses the stock module).
# Import providers: stub modules that only carry the OS4 stock export CRCs (stubs_a17B/os4, generated by gen_stubs.py).
ddk_module(
    name = "mca_charger_thermal",
    srcs = ["mca_charger_thermal.c"] + glob(["inc/*.h"]),
    out = "mca_charger_thermal.ko",
    defconfig = "mca_charger_thermal_defconfig",
    local_defines = ["CONFIG_LTO=1"],
    copts = ["-ffunction-sections", "-fdata-sections"],
    kernel_build = "//common:kernel_aarch64",
    deps = [
        "//re/stubs_a17A:mca_headers",
        "//re/stubs_a17B/os4:os4_mca_log",
        "//re/stubs_a17B/os4:os4_mca_common",
        "//re/stubs_a17B/os4:os4_mca_hwid",
        "//re/stubs_a17B/os4:os4_mca_parse_dts",
        "//re/stubs_a17B/os4:os4_mca_qcom_smem",
        "//re/stubs_a17B/os4:os4_mca_smart_charge",
        "//re/stubs_a17B/os4:os4_mca_strategy_class",
        "//re/stubs_a17B/os4:os4_mca_sysfs",
        "//re/stubs_a17B/os4:os4_mca_platform_fg_ic_ops",
        "//re/stubs_a17B/os4:os4_mca_protocol_class",
        "//common:all_headers_aarch64",
    ],
)
