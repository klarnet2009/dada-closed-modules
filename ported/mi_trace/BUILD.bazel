load("/<build-dir>", "ddk_module")

ddk_module(
    name = "mi_trace",
    srcs = glob(["*.c", "*.h"]),
    out = "mi_trace.ko",
    defconfig = "mi_trace_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    copts = ["-ffunction-sections", "-fdata-sections"],
    local_defines = ["CONFIG_LTO=1", "CONFIG_QCOM_MINIDUMP=1"],
    visibility = ["//re:__subpackages__"],
    kernel_build = "//common:kernel_aarch64",
    deps = ["//re/stubs_portA:portA_headers", "//re/stubs_portA:minidump_stub", "//common:all_headers_aarch64"],
)
