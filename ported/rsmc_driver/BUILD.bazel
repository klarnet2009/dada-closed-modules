load("/<build-dir>", "ddk_module")

ddk_module(
    name = "rsmc_driver",
    srcs = glob(["*.c", "*.h", "x801/*.c", "x801/*.h"]),
    out = "rsmc_driver.ko",
    includes = [".", "x801"],
    defconfig = "rsmc_driver_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    copts = ["-ffunction-sections", "-fdata-sections"],
    local_defines = ["CONFIG_LTO=1"],
    visibility = ["//re:__subpackages__"],
    kernel_build = "//common:kernel_aarch64",
    deps = ["//re/stubs_portA:portA_headers", "//re/stubs_portA:pinctrl_msm_stub", "//common:all_headers_aarch64"],
)
