load("/<build-dir>", "ddk_module")

package(default_visibility = ["//re:__subpackages__"])

ddk_module(
    name = "hwid",
    srcs = ["hwid.c"],
    out = "hwid.ko",
    defconfig = "hwid_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    local_defines = ["CONFIG_LTO=1", "CONFIG_QCOM_SOCINFO=1"],
    copts = ["-ffunction-sections", "-fdata-sections"],
    kernel_build = "//common:kernel_aarch64",
    deps = [
        "//re/stubs_portC:socinfo_stub",
        "//re/stubs_portC:portC_headers",
        "//common:all_headers_aarch64",
    ],
)
