load("/<build-dir>", "ddk_module")

ddk_module(
    name = "rss_monitor",
    srcs = glob(["*.c", "*.h"]),
    out = "rss_monitor.ko",
    defconfig = "rss_monitor_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    copts = ["-ffunction-sections", "-fdata-sections"],
    local_defines = ["CONFIG_LTO=1"],
    visibility = ["//re:__subpackages__"],
    kernel_build = "//common:kernel_aarch64",
    deps = ["//common:all_headers_aarch64"],
)
