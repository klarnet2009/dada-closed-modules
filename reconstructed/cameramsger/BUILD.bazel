    name = "cameramsger",
    srcs = ["cameramsger.c"],
    out = "cameramsger.ko",
    defconfig = "cameramsger_defconfig",  # stock modules are ThinLTO builds
    local_defines = ["CONFIG_LTO=1"],
    kernel_build = "//common:kernel_aarch64",
    deps = ["//common:all_headers_aarch64"],
)
