load("/<build-dir>", "ddk_module")

ddk_module(
    name = "tas25xx",
    srcs = glob(["src/*.c", "inc/*.h"]),
    out = "tas25xx.ko",
    includes = ["inc"],
    defconfig = "tas25xx_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    local_defines = [
        "CONFIG_SND_SOC_TAS25XX=1",
        "CONFIG_TAS25XX_MISC=1",
    ],
    kernel_build = "//common:kernel_aarch64",
    deps = ["//common:all_headers_aarch64"],
)
