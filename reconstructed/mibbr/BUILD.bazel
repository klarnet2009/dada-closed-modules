load("/<build-dir>", "ddk_module")

ddk_module(
    name = "mibbr",
    srcs = [
        "mibbr_internal.h",
        "tcp_mibbr.c",
        "mibbr_config.c",
        "minet_ext.c",
    ],
    out = "mibbr.ko",
    defconfig = "mibbr_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN
    kernel_build = "//common:kernel_aarch64",
    deps = ["//common:all_headers_aarch64"],
)
