# OS4 build: headers = //re/stubs_g5, providers = forged OS4 stubs //re/stubs_a17B/os4:os4_* (exact stock export CRCs). Community-only charging source: never flash, never put into a ROM build.
load("/<build-dir>", "ddk_module")

ddk_module(
    name = "mca_strategy_fg_comp",
    srcs = [
        "strategy_fg.h",
        "mca_battery_shutdown.h",
        "mca_strategy_fg.c",
        "mca_soc_smooth.c",
        "mca_battery_shutdown.c",
        "mca_battery_safe.c",
    ],
    out = "mca_strategy_fg_comp.ko",
    defconfig = "mca_strategy_fg_comp_defconfig",  # stock was built with CONFIG_LTO_CLANG_THIN (cross-file imports, import-instr-limit=5)
    local_defines = ["CONFIG_DEBUG_FS=1"],
    copts = ["-ffunction-sections", "-fdata-sections"],  # stock was LTO-linked per function/data section: local calls keep CALL26 relocs
    kernel_build = "//common:kernel_aarch64",
    deps = [
        "//re/stubs_g13d_g2k:mca_headers",
        "//re/stubs_a17B/os4:os4_charger_partition",
        "//re/stubs_a17B/os4:os4_mca_charge_mievent",
        "//re/stubs_a17B/os4:os4_mca_common",
        "//re/stubs_a17B/os4:os4_mca_event",
        "//re/stubs_a17B/os4:os4_mca_hwid",
        "//re/stubs_a17B/os4:os4_mca_log",
        "//re/stubs_a17B/os4:os4_mca_parse_dts",
        "//re/stubs_a17B/os4:os4_mca_platform_buckchg_class",
        "//re/stubs_a17B/os4:os4_mca_platform_fg_ic_ops",
        "//re/stubs_a17B/os4:os4_mca_platform_loadsw_class",
        "//re/stubs_a17B/os4:os4_mca_protocol_class",
        "//re/stubs_a17B/os4:os4_mca_protocol_pd_class",
        "//re/stubs_a17B/os4:os4_mca_qcom_smem",
        "//re/stubs_a17B/os4:os4_mca_smart_charge",
        "//re/stubs_a17B/os4:os4_mca_strategy_class",
        "//re/stubs_a17B/os4:os4_mca_strategy_fg_class",
        "//re/stubs_a17B/os4:os4_mca_sysfs",
        "//re/stubs_a17B/os4:os4_mca_workqueue",
        "//common:all_headers_aarch64",
